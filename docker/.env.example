# Development-only example values. Copy to docker/.env and adjust locally.
IM_MYSQL_ROOT_PASSWORD=im-local-root-example
IM_MYSQL_DATABASE=im
IM_MYSQL_USER=im_dev
IM_MYSQL_PASSWORD=im-local-app-example
IM_MYSQL_PORT=3306
IM_REDIS_PORT=6379
IM_BACKEND_PORT=8080
IM_FRONTEND_PORT=8081
# Add IM_JWT_SECRET with a secret generated by openssl rand -hex 32.
